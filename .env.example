# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Gemini API Keys (GEMINI_API_KEY or GEMINI_API_KEY_1..3)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-flash-latest

# Optional: Channel scoping (leave 0/empty to allow all channels)
ALLOWED_CHANNEL_ID=0
MUSIC_CHANNEL_ID=0

# Optional: GitHub Gist integration
GITHUB_TOKEN=

# Runtime storage
DATA_DIR=data
